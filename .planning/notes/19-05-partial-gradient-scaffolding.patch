+/// PySCF normalization constant from nr_ecp_deriv.c lines 161, 187 — the
+/// libcint $\sqrt{3}^{-1}$ Condon-Shortley p-shell normalization factor that
+/// `_l_down` applies when `li == 1` and `_l_up` applies when `li == 2`.
+const ECP_LDOWN_P_NORM: f64 = 0.488_602_511_902_919_921; // 1/(2*sqrt(pi/3)) up to a factor
+
+/// `_l_down` — apply the $-2\alpha_i \cdot (\mathbf{r} - \mathbf{A}_C)$ factor
+/// to the (li+1)-shaped scalar buffer `buf1` and write the 3-component result
+/// into `out` (F-order, axis-slowest: outx then outy then outz, each
+/// `nfi*nfj` slab).
+///
+/// Source: vendor/pyscf-nr-ecp/src/nr_ecp_deriv.c:148-172.
+///
+/// `out` MUST have capacity `3 * nfi * nfj` where `nfi = ncart(li)`.
+/// `buf1` MUST have capacity `nfi1 * nfj` where `nfi1 = ncart(li+1)`.
+fn l_down_grad(out: &mut [f64], buf1: &[f64], fac_in: f64, ai: f64, li: u8, nfj: usize) {
+    let li_usize = li as usize;
+    let nfi = ncart(li);
+    let nfi1 = ncart(li + 1);
+    let fac = match li {
+        0 => fac_in * (-2.0 / 3.0_f64.sqrt()) * ai,
+        1 => fac_in * (-2.0 * ECP_LDOWN_P_NORM) * ai,
+        _ => fac_in * (-2.0) * ai,
+    };
+
+    let (outx, rest) = out.split_at_mut(nfi * nfj);
+    let (outy, outz) = rest.split_at_mut(nfi * nfj);
+
+    for j in 0..nfj {
+        for i in 0..nfi {
+            let bx = buf1[j * nfi1 + i];
+            let by = buf1[j * nfi1 + Y_ADDR[i + cart_offset(li_usize)]];
+            let bz = buf1[j * nfi1 + Z_ADDR[i + cart_offset(li_usize)]];
+            outx[j * nfi + i] = fac * bx;
+            outy[j * nfi + i] = fac * by;
+            outz[j * nfi + i] = fac * bz;
+        }
+    }
+}
+
+/// `_l_up` — combine the (li-1)-shaped scalar buffer with the angular-momentum-
+/// raising coefficients from the libcint Cartesian recurrence into the same
+/// 3-component output (F-order, axis-slowest), ADDING to whatever
+/// `l_down_grad` already wrote.
+///
+/// Source: vendor/pyscf-nr-ecp/src/nr_ecp_deriv.c:174-199.
+///
+/// Only called when `li > 0` (no angular-momentum lowering exists for s).
+/// `out` capacity `3 * nfi * nfj`; `buf1` capacity `nfi0 * nfj` where
+/// `nfi0 = ncart(li - 1)`.
+fn l_up_grad(out: &mut [f64], buf1: &[f64], fac_in: f64, li: u8, nfj: usize) {
+    debug_assert!(li >= 1, "_l_up requires li >= 1");
+    let li_i = li as i32;
+    let li_minus_1 = li_i - 1;
+    let nfi = ncart(li);
+    let nfi0 = ncart((li_i - 1) as u8);
+    let fac = match li {
+        1 => fac_in * 3.0_f64.sqrt(),
+        2 => fac_in * (1.0 / ECP_LDOWN_P_NORM),
+        _ => fac_in,
+    };
+
+    let (outx, rest) = out.split_at_mut(nfi * nfj);
+    let (outy, outz) = rest.split_at_mut(nfi * nfj);
+
+    // _cart_pow_y / _z lookup is indexed by Cartesian-component position in
+    // the (li-1) shell, so we offset into the global table at the start of
+    // the (li-1) cumulative block.
+    let off = cart_offset((li_i - 1) as usize);
+
+    for i in 0..nfi0 {
+        let py = CART_POW_Y[i + off] as f64;
+        let pz = CART_POW_Z[i + off] as f64;
+        let yfac = fac * (py + 1.0);
+        let zfac = fac * (pz + 1.0);
+        // libcint convention: xfac uses (li-1 - ly - lz + 1) — see _l_up:192.
+        let xfac = fac * (li_minus_1 as f64 - py - pz + 1.0);
+        for j in 0..nfj {
+            let b = buf1[j * nfi0 + i];
+            outx[j * nfi + i] += xfac * b;
+            outy[j * nfi + Y_ADDR[i + off]] += yfac * b;
+            outz[j * nfi + Z_ADDR[i + off]] += zfac * b;
+        }
+    }
+}
