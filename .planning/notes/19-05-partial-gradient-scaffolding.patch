+/// Cumulative Cartesian-component offset for the start of the l-th shell
+/// inside the flat tables Y_ADDR / Z_ADDR / CART_POW_Y / CART_POW_Z.
+///
+/// Tables are laid out for l = 0, 1, 2, ..., 14 concatenated. Sum of
+/// ncart(0..l) = l*(l+1)*(l+2)/6.
+fn cart_offset(l: usize) -> usize {
+    l * (l + 1) * (l + 2) / 6
+}
