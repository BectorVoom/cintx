+/// Build a synthetic single-primitive, single-contraction Shell at the
+/// requested angular momentum reusing `prototype`'s atom_index. Used by the
+/// gradient branch to evaluate Type-1+Type-2 scalars at li+1 / li-1 without
+/// rebuilding the full plan.
+///
+/// The synthesized shell carries exactly one exponent and one coefficient
+/// (both supplied by the caller), so the existing `compute_type{1,2}_pair`
+/// inner loops consume it the same way they consume a real shell.
+fn synthetic_single_prim_shell(prototype: &Shell, l: u8, exp: f64, coeff: f64) -> Shell {
+    Shell {
+        atom_index: prototype.atom_index,
+        ang_momentum: l,
+        nprim: 1,
+        nctr: 1,
+        kappa: 0,
+        representation: prototype.representation,
+        exponents: Arc::from(vec![exp].into_boxed_slice()),
+        coefficients: Arc::from(vec![coeff].into_boxed_slice()),
+    }
+}
